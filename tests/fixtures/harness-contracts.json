    {
      "id": "D2",
      "kind": "delivery_dod",
      "input": {
        "result": "pass",
        "target_state": "OPEN"
      },
      "expected": {
        "result": "pass",
        "recommendation": "close",
        "decision_owner": "PO",
        "state": "awaiting_po_closure",
        "target_state": "OPEN",
        "authorization": "pending",
        "close_attempts": 0
      }
    },
    {
      "id": "D3",
      "kind": "po_authorization",
      "input": {
        "target": 9001,
        "valid": "Разрешаю закрыть задачу #9001.",
        "invalid": [
          "сделай #9001",
          "закрой #9001",
          "Разрешаю закрыть задачу #9002.",
          "Разрешаю закрыть задачи #9001 и #9002."
