    "state": "OPEN",
    "labels": ["meta"],
    "atomic": false,
    "depends_on": [101, 105],
    "subissues": {
      "102": "CLOSED",
      "103": "CLOSED",
      "104": "CLOSED",
      "105": "OPEN"
    }
  },
  "cases": [
    {
      "id": "D1",
      "kind": "delivery_contract",
      "input": {
        "source": ".opencode/agent/delivery.md"
